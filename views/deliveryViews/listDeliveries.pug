extends ../layout

block content
  h2.mb-4 Listado de Pedidos

  a.btn.btn-secondary.mb-3.ms-2(href="/delivery") ← Volver al menú

  if query.success
    script.
      if ('!{query.success}' === 'eliminado') {
        alert('¡Pedido eliminado con éxito!');
      } else {
        alert('¡Pedido creado con éxito!');
      }

  if query.error
    .alert.alert-danger Error: !{query.error}

  if deliveries && deliveries.length
    table.table.table-striped.table-hover
      thead.table-dark
        tr
          th #
          th ID Pedido
          th ID Cliente
          th Nombre Cliente
          th Total Ítems
          th Estado
          th Total ($)
          th Repartidor
          th Est. Entrega / Real
          th Restante
          th Estado Entrega
          th Plataforma
          th Acciones

      tbody
        each delivery, index in deliveries
          tr
            td= index + 1
            td= delivery._id
            td= delivery.customerDisplayId
            td= delivery.customerName
            td= delivery.totalItems

            // Estado base (preparando/despachado/entregado)
            - var statusText = 'Entregado'
            - if (delivery.status === 'preparing') statusText = 'Preparando'
            - else if (delivery.status === 'dispatched') statusText = 'Despachado'
            - else if (delivery.status === 'pending') statusText = 'Pendiente'

            - var statusClass = 'bg-success'
            - if (delivery.status === 'preparing') statusClass = 'bg-warning'
            - else if (delivery.status === 'dispatched') statusClass = 'bg-primary'
            - else if (delivery.status === 'pending') statusClass = 'bg-info'

            td
              span.badge(class=statusClass)= statusText

            td= delivery.total
            td= delivery.assignedRiderId || '-'

            // ETA o hora real de entrega
            td
              if delivery.deliveredAt
                span.text-success Entregado a las #{delivery.deliveredAt}
              else
                = delivery.estimatedDelivery || "-"

            // Tiempo restante
            td
              if delivery.deliveredAt
                span.text-muted N/A
              else
                = delivery.remainingTime || "-"

            // Estado de entrega (a tiempo / atrasado / entregado)
            td
              if delivery.deliveredAt
                span.text-success Entregado
              else if delivery.delayed
                span.text-danger Atrasado
              else
                span.text-primary A tiempo

            td= delivery.plataforma || '-'

            td
              a.btn.btn-sm.btn-primary(href=`/delivery/update?id=${delivery._id}`) Editar
              a.btn.btn-sm.btn-danger.ms-2(href=`/delivery/delete?id=${delivery._id}`) Eliminar

  else
    p.text-muted No hay pedidos registrados aún.

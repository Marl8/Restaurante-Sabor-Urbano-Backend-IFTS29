extends ../layout

block content
  h2.mb-4 Agregar Usuario

  a.btn.btn-secondary.mb-3.ms-2(href="/users") ← Volver al menú

  if query && query.error
    .alert.alert-danger Error: !{query.error}

  form(method="post" action="/users/save")
    .mb-3
      label.form-label(for="name") Nombre
      input.form-control(
        type="text",
        name="name",
        id="name",
        autocomplete="name",
        required,
        pattern="[a-zA-Z\\s]+",
        title="El nombre solo debe contener letras y espacios"
      )

    .mb-3
      label.form-label(for="dni") DNI
      input.form-control(
        type="number",
        name="dni",
        id="dni",
        autocomplete="off",
        required,
        pattern="\\d+",
        title="El DNI solo debe contener números"
      )

    .mb-3
      label.form-label(for="email") Email
      input.form-control(
        type="email",
        name="email",
        id="email",
        autocomplete="email",
        required
      )

    .mb-3
      label.form-label(for="username") Usuario
      input.form-control(
        type="text",
        name="username",
        id="username",
        autocomplete="username",
        required
      )

    .mb-3
      label.form-label(for="password") Contraseña
      input.form-control(
        type="password",
        name="password",
        id="password",
        autocomplete="new-password",
        required
      )

    .mb-3
      label.form-label(for="rol") Rol
      select.form-select(name="rol", id="rol", required)
        option(value="Empleado" selected) Empleado
        option(value="Admin") Admin

    button.btn.btn-success(type="submit") Guardar
    a.btn.btn-secondary.ms-2(href="/users") Cancelar
